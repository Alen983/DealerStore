            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <inputConfiguratorMode>Custom</inputConfiguratorMode>
                <stringValue>The early access period has ended for the producut -  {!$Record.Name} with  product code {!$Record.ProductCode}

The product has now been released and is available to all dealers.

This notification was automatically generated by the Product Early Access Release Flow.</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>3.0.1</versionString>
    </actionCalls>
