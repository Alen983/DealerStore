    <decisions>
        <name>Determine_Product_Category</name>
        <label>Determine Product Category</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Sports</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Category_Details.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Apparels</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Category_Details.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sports Shoes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sports_Silver_Policy</targetReference>
            </connector>
            <label>Sports</label>
        </rules>
        <rules>
            <name>Electronics</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Category_Details.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Kitchen Appliances</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Category_Details.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Beauty Products</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Electronics_Silver_Policy</targetReference>
            </connector>
            <label>Electronics</label>
        </rules>
    </decisions>
