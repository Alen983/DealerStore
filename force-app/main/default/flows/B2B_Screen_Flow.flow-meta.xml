    <recordCreates>
        <description>Recurring order created from B2B storefront.</description>
        <name>Create_Recurring_Contract</name>
        <label>Create Recurring Contract</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Dealer_Store_Price_Book</targetReference>
        </connector>
        <inputAssignments>
            <field>Buyer_Account__c</field>
            <value>
                <elementReference>Get_Buyer_Account.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contract_End_Date__c</field>
            <value>
                <dateValue>2027-12-31</dateValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contract_Start_Date__c</field>
            <value>
                <elementReference>Start_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Contract_Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Frequency__c</field>
            <value>
                <elementReference>Delivery_Frequency</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Last_Order_Date__c</field>
            <value>
                <elementReference>Start_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Next_Order_Date__c</field>
            <value>
                <elementReference>Start_Date</elementReference>
            </value>
        </inputAssignments>
        <object>Recurring_Contract__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>Creates the recurring contract line item for the selected product.</description>
        <name>Create_Recurring_Contract_Line_Item</name>
        <label>Create Recurring Contract Line Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Recurring_Order_Submitted</targetReference>
        </connector>
        <inputAssignments>
            <field>Contract_Price__c</field>
            <value>
                <elementReference>Get_Product_Price.UnitPrice</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Delivery_Frequency__c</field>
            <value>
                <elementReference>Delivery_Frequency</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Next_Delivery_Date__c</field>
            <value>
                <elementReference>Start_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Product__c</field>
            <value>
                <elementReference>Product_New.selectedChoiceValues</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Quantity__c</field>
            <value>
                <elementReference>Quantity</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Recurring_Contract__c</field>
            <value>
                <elementReference>Create_Recurring_Contract.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <object>Recurring_Contract_Line_Item__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
