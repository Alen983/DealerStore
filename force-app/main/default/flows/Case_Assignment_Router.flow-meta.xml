    <environments>Default</environments>
    <formulas>
        <name>Formula_Calculated_SLA_Deadline</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + ({!Formula_SLA_Hours} / 24)</expression>
    </formulas>
    <formulas>
        <name>Formula_SLA_Hours</name>
        <dataType>Number</dataType>
        <expression>IF(
  ISPICKVAL({!$Record.Priority}, &quot;High&quot;), 4,
  IF(
    ISPICKVAL({!$Record.Priority}, &quot;Medium&quot;), 24,
    48
  )
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>frm_Lowercase_Subject</name>
        <dataType>String</dataType>
        <expression>LOWER({!$Record.Subject})</expression>
    </formulas>
