<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Update_Credit_Values</name>
        <label>Update Credit Values</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Dealer_Account.Used_Credit__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NewUsedCredit</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Dealer_Account.Available_Credit__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NewAvailableCredit</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Dealer_Credit</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_Order_Exceeding_Available_Credit</name>
        <label>Is Order Exceeding Available Credit?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Credit_Values</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Within Credit Limit</defaultConnectorLabel>
        <rules>
            <name>Exceeds_Credit_Limit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.TotalAdjustedProductAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Get_Dealer_Account.Available_Credit__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Order_Status_to_On_Hold</targetReference>
            </connector>
            <label>Exceeds Credit Limit</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>NewAvailableCredit</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE ({!Get_Dealer_Account.Credit_Limit__c}, 0) - {!NewUsedCredit}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NewUsedCredit</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!Get_Dealer_Account.Used_Credit__c}, 0) + {!$Record.TotalAdjustedProductAmount}</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Update Dealer Credit After Order {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Dealer Credit After Order</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Dealer_Account</name>
        <label>Get Dealer Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Order_Exceeding_Available_Credit</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Dealer_Credit</name>
        <label>Update Dealer Credit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_the_triggering_Order_Summary</targetReference>
        </connector>
        <inputReference>Get_Dealer_Account</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Order_Status_to_On_Hold</name>
        <label>Update Order Status to On Hold</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>On Hold</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_the_triggering_Order_Summary</name>
        <label>Update the triggering Order Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Credit_Processed_c__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Dealer_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Credit_Processed_c__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>OrderSummary</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
