                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Dealer_Store_Price_Book</targetReference>
            </connector>
            <label>Yes - Delivery Due</label>
        </rules>
    </decisions>
