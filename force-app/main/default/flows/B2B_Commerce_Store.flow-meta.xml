    <formulas>
        <description>Calculates the next delivery date based on the recurring contract line item&apos;s delivery frequency.</description>
        <name>frm_NextDeliveryDate</name>
        <dataType>Date</dataType>
        <expression>CASE(
TEXT($Record.Delivery_Frequency__c),
&quot;Monthly&quot;, ADDMONTHS($Record.Next_Delivery_Date__c, 1),
&quot;Quarterly&quot;, ADDMONTHS($Record.Next_Delivery_Date__c, 3),
&quot;Half-Yearly&quot;, ADDMONTHS($Record.Next_Delivery_Date__c, 6),
&quot;Yearly&quot;, ADDMONTHS($Record.Next_Delivery_Date__c, 12),
ADDMONTHS($Record.Next_Delivery_Date__c, 1)
)</expression>
    </formulas>
