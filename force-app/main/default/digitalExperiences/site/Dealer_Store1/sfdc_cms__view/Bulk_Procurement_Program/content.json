          "children" : [ {
            "children" : [ {
              "attributes" : {
                "imageInfos" : "",
                "richTextValue" : "<div class=\"bpp-page\">\n    <p class=\"bpp-intro\">Dealer Store enables business buyers to procure products in bulk through a self-service B2B Commerce portal. Your discount tier is based on <strong>total procurement spend</strong> across all completed orders — the more you buy over time, the greater your wholesale savings.</p>\n\n    <section class=\"bpp-section\">\n        <h2 class=\"bpp-heading\">Tiered Wholesale Discounts</h2>\n        <div class=\"bpp-tiers\">\n            <div class=\"bpp-tier bpp-tier--basic\">\n                <p class=\"bpp-tier-name\">Basic</p>\n                <p class=\"bpp-tier-threshold\">$2,500+ total spend</p>\n                <p class=\"bpp-tier-discount\">5% <span>OFF</span></p>\n            </div>\n            <div class=\"bpp-tier bpp-tier--premium\">\n                <p class=\"bpp-tier-name\">Premium</p>\n                <p class=\"bpp-tier-threshold\">$5,000+ total spend</p>\n                <p class=\"bpp-tier-discount\">10% <span>OFF</span></p>\n            </div>\n            <div class=\"bpp-tier bpp-tier--elite\">\n                <p class=\"bpp-tier-name\">Elite</p>\n                <p class=\"bpp-tier-threshold\">$10,000+ total spend</p>\n                <p class=\"bpp-tier-discount\">15% <span>OFF</span></p>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"bpp-section\">\n        <h2 class=\"bpp-heading\">Program Benefits</h2>\n        <ul class=\"bpp-benefit-grid\">\n            <li>Self-service bulk ordering experience</li>\n            <li>Tier upgrades based on lifetime procurement spend</li>\n            <li>Transparent pricing — no coupon codes</li>\n            <li>Buyer-specific product access by business type</li>\n            <li>Faster procurement for retailers and distributors</li>\n        </ul>\n    </section>\n\n    <section class=\"bpp-section\">\n        <h2 class=\"bpp-heading\">How It Works</h2>\n        <ol class=\"bpp-steps\">\n            <li>Log in as a business buyer</li>\n            <li>Browse products for your account</li>\n            <li>Place bulk orders through the storefront</li>\n            <li>Your total spend accumulates across all orders</li>\n            <li>Unlock Premium and Elite tiers as spend grows</li>\n            <li>Track savings and tier status on My Procurement Benefits</li>\n        </ol>\n    </section>\n\n    <section class=\"bpp-section\">\n        <h2 class=\"bpp-heading\">Supported Buyer Types</h2>\n        <div class=\"bpp-tags\">\n            <span class=\"bpp-tag\">Electronics Retailers</span>\n            <span class=\"bpp-tag\">Sports Retailers</span>\n            <span class=\"bpp-tag\">Multi-category Wholesale Distributors</span>\n        </div>\n    </section>\n\n    <p class=\"bpp-footer\">Dealer Store's Bulk Procurement Program simplifies inventory replenishment and rewards long-term buyers through automated, tiered wholesale discounts powered by Salesforce B2B Commerce.</p>\n</div>"
              },
